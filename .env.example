# Database connection
DB_HOST=localhost
DB_USER=rcpd
DB_PASS=change-me
DB_NAME=rcpd

# USB-to-RS485 converter, usually CH340-based
#DEVICE=/dev/ttyUSB0
# Waveshare RS485 CAN HAT
DEVICE=/dev/ttyAMA0

# R421B16 factory default is 9600.
BAUD_RATE=9600

# Listen on localhost by default
WS_SERVER_LISTENING_ADDR=127.0.0.1
WS_SERVER_LISTENING_PORT=8001

# Maximum number of queued relay commands
COMMAND_QUEUE_MAX_SIZE=100

# Use local paths during development if /var/log or /var/run require root
LOG_FILE=/var/log/rcpd.log
PID_FILE=/var/run/rcpd.pid
